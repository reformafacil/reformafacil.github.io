rules_version = '2';

// Regras de segurança do Reforma Fácil (cole no Firebase Console → Firestore → Regras).
//
// Estrutura:
//   admins/{uid}                         existe = é administrador (criado à mão no Console)
//   usuarios/{uid}                       { nome, email, ativo, validade, sessao: { id, aparelho, em } }
//   usuarios/{uid}/clientes/{clienteId}  { nome, documento, operacao, sessao, atualizadoEm }
//   usuarios/{uid}/config/marca          { nome, contato, logo } do escritório, para o relatório
//   solicitacoes/{id}                    pedidos de acesso da página inicial
//   pagamentos/{pedido}                  links e pagamentos da InfinitePay (só o servidor grava)
//   estornos/{id}                        cancelamentos dentro dos 7 dias
service cloud.firestore {
  match /databases/{db}/documents {

    function logado() { return request.auth != null; }
    function eu(uid) { return logado() && request.auth.uid == uid; }
    function admin() { return logado() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function perfil(uid) { return get(/databases/$(db)/documents/usuarios/$(uid)).data; }
    // acesso liberado pelo administrador e dentro da validade
    function acessoValido(uid) {
      let p = perfil(uid);
      return p.ativo == true && p.validade > request.time;
    }

    match /admins/{uid} {
      allow read: if eu(uid);
      allow write: if false;            // só pelo Console
    }

    match /usuarios/{uid} {
      allow read: if admin() || eu(uid);
      allow create, delete: if admin();
      // o administrador edita tudo; o próprio usuário só troca a sessão ativa (login derruba o aparelho anterior)
      allow update: if admin()
        || (eu(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessao'])
            && request.resource.data.sessao.id is string
            && request.resource.data.sessao.id.size() >= 16);

      // marca do escritório usada no relatório em PDF (logo em imagem reduzida, até ~300 KB)
      match /config/{doc} {
        allow read: if eu(uid) && acessoValido(uid);
        allow write: if eu(uid) && acessoValido(uid) && doc == 'marca'
          && request.resource.data.keys().hasOnly(['nome', 'contato', 'logo', 'atualizadoEm'])
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
          && request.resource.data.contato is string && request.resource.data.contato.size() <= 200
          && request.resource.data.logo is string && request.resource.data.logo.size() <= 300000
          && (request.resource.data.logo == '' || request.resource.data.logo.matches('^data:image/(png|jpeg);base64,.*'));
      }

      match /clientes/{clienteId} {
        allow read, delete: if eu(uid) && acessoValido(uid);
        // gravações só valem vindas da sessão ativa: um aparelho derrubado não consegue mais salvar
        allow create, update: if eu(uid) && acessoValido(uid)
          && request.resource.data.sessao == perfil(uid).sessao.id
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 0
          && request.resource.data.nome.size() <= 120;
      }
    }

    // pedidos de acesso feitos na página inicial: qualquer pessoa envia, só o administrador lê
    match /solicitacoes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'email', 'telefone', 'perfil', 'mensagem', 'criadoEm'])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.email.size() <= 160
        && request.resource.data.telefone is string && request.resource.data.telefone.size() <= 30
        && request.resource.data.perfil is string && request.resource.data.perfil.size() <= 60
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 1000
        && request.resource.data.criadoEm == request.time;
      allow read, delete: if admin();
    }

    // pagamentos: gravados só pelo servidor (Functions); o administrador consulta
    match /pagamentos/{id} {
      allow read: if admin();
      allow write: if false;
    }

    // pedidos de estorno (garantia de 7 dias): criados pelo servidor; o administrador marca como feito
    match /estornos/{id} {
      allow read: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'feitoEm'])
        && request.resource.data.status in ['pendente', 'feito'];
      allow create, delete: if false;
    }

    // todo o resto é negado
  }
}
